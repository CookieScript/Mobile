local Library = {}
--
do --
    Library = {
        ["Registers"] = {},
        ["Theme"] = {
            ["AccentColor"] = Color3.fromRGB(104, 154, 189),
            ["MainColor"] = Color3.fromRGB(60, 60, 60),
            ["Outline"] = Color3.fromRGB(45, 45, 45),
            ["Background"] = Color3.fromRGB(20, 20, 20),
            ["FontColor"] = Color3.fromRGB(255, 255, 255),
            ["Black"] = Color3.fromRGB(0, 0, 0),
        },
        ["ScreenGui"] = {},
        ["Font"] = nil,
    }
    --
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer
    local Mouse = LocalPlayer:GetMouse()
    --
    function Library:Create(class, prop)
        local obj = Instance.new(class)
        for i, v in prop do
            obj[i] = v
        end
        return obj
    end
    --
    Library["ScreenGui"] = Library:Create("ScreenGui", {
        ["Name"] = "brainsense",
        ["Parent"] = game:GetService("CoreGui"),
    })
    --
    Library["Font"] = Enum["Font"]["GothamBold"]
    --
    function Library:AddThemeColor(ins, prop)
        local i = #Library["Registers"] + 1
        local d = {
            ["Instance"] = ins,
            ["Prop"] = prop,
            ["I"] = i,
        }
        table.insert(Library["Registers"], d)
    end
    --
    function Library:UpdateThemeColor()
        for i, v in Library["Registers"] do
            for p, c in v["Prop"] do
                v["Instance"][p] = Library["Theme"][c]
            end
        end
    end
    --
    function Library:MakeDraggable(ins)
        ins["Active"] = true

        ins.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                local Pos = Vector2.new(Mouse.X - ins.AbsolutePosition.X, Mouse.Y - ins.AbsolutePosition.Y)
                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    ins["Position"] = UDim2.new(0, Mouse.X - Pos.X + (ins["Size"]["X"]["Offset"] * ins["AnchorPoint"]["X"]), 0, Mouse.Y - Pos.Y + (ins["Size"]["Y"]["Offset"]  * ins["AnchorPoint"]["Y"]))
                    task.wait()
                end
            end
        end)
    end
    --
    function Library:CreateWindow(prop)
        local window = {
            ["size"] = prop.Size or prop.size or UDim2.new(0, 576, 0, 450),
            ["position"] = prop.Position or prop.position or prop.Pos or prop.pos or UDim2.new(0.5, -288, 0.5, -225),
            ["title"] = prop.Title or prop.title or "brainsense",
            ["icon"] = prop.Icon or prop.icon,
        }
        --
        local MenuFrame = Library:Create("Frame", {
            ["Size"] = window["size"],
            ["Position"] = window["position"],
            ["BackgroundColor3"] = Library["Theme"]["Background"],
            ["BorderSizePixel"] = 0,
            ["Parent"] = Library["ScreenGui"],
            ["Visible"] = true,
        })
        --
        Library:MakeDraggable(MenuFrame)
        --
        Library:Create("UICorner", {
            ["CornerRadius"] = UDim.new(0, 4),
            ["Parent"] = MenuFrame,
        })
        --
        Library:AddThemeColor(MenuFrame, {
            ["BackgroundColor3"] = "Background",
        })
        --
        local WindowIcon = Library:Create("ImageLabel", {
            ["Size"] = UDim2.new(0, 35, 0, 35),
            ["Position"] = UDim2.new(0, 15, 0, 15),
            ["BackgroundTransparency"] = 1,
            ["BorderSizePixel"] = 0,
            ["Image"] = window["icon"] or "",
            ["ImageColor3"] = Library["Theme"]["AccentColor"],
            ["ImageTransparency"] = 0,
            ["ScaleType"] = Enum["ScaleType"]["Slice"],
            ["Parent"] = MenuFrame,
            ["Visible"] = true,
        })
        --
        Library:AddThemeColor(WindowIcon, {
            ["ImageColor3"] = Library["Theme"]["AccentColor"],
        })
        --
        local WindowTitle = Library:Create("TextLabel", {
            ["Size"] = UDim2.new(0, 65, 0, 10),
            ["Position"] = UDim2.new(1, 5, 0, 3),
            ["BorderSizePixel"] = 0,
            ["BackgroundTransparency"] = 1,
            ["Text"] = window["title"],
            ["TextSize"] = 13,
            ["TextXAlignment"] = Enum["TextXAlignment"]["Left"],
            ["Font"] = Library["Font"],
            ["TextColor3"] = Library["Theme"]["FontColor"],
            ["Parent"] = WindowIcon,
            ["Visible"] = true,
        })
        --
        Library:AddThemeColor(WindowTitle, {
            ["TextColor3"] = "FontColor",
        })
    end
end

-- return Library

local window = Library:CreateWindow({icon = "rbxassetid://87369894709952"})

task.wait(9e9)
Library["Theme"]["AccentColor"] = Color3.fromRGB(25, 25, 25)
Library["Theme"]["Background"] = Color3.fromRGB(255, 255, 255)
Library:UpdateThemeColor()
