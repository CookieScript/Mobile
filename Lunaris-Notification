local Library = {}

do
    Library = {
        Notification = {
            Images = {
                ["Success"] = "rbxassetid://122842703742343",
                ["Failed"] = "rbxassetid://96260917665176",
                ["Info"] = "rbxassetid://100098274347190",
            },
        },
        AnimationSpeed = 250,
        ScreenGui = nil,
    }

    function Library:Create(class, property)
        local object = Instance.new(class)

        for index, value in property do
            object[index] = value
        end

        return object
    end

    function Library:Tween(Object, Info, Properties)
        local Tween = game:GetService("TweenService"):Create(Object, Info, Properties)
        Tween:Play()

        return Tween
    end

    function Library:GetTextSize(Text, Font, Size)
        return game:GetService("TextService"):GetTextSize(Text, Size, Font, Vector2.new(math.huge, math.huge))
    end

    Library.ScreenGui = Library:Create("ScreenGui", {
        Parent = game:GetService("CoreGui"),
    })

    local NotificationFrame = Library:Create("Frame", {
        Size = UDim2.new(0, 500, 0, 200),
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.62, 0),
        BackgroundTransparency = 1,
        Parent = Library.ScreenGui,
    })

    Library:Create("UIListLayout", {
        Padding = UDim.new(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Top,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = NotificationFrame,
    })

    function Library:CreateLunarisNotification(Info)
        local config = {
            Status = Info.Status or Info.status or Info.Stats or Info.stats or "Success",
            Message = Info.Message or Info.message or Info.Msg or Info.msg or "Notification",
            Time = Info.Duration or Info.duration or Info.Dur or Info.dur or 5,
            TextColor = Info.Color or Info.color or Color3.fromRGB(255, 255, 255),
        }

        local MainNotificationInner = Library:Create("Frame", {
            Size = UDim2.new(0, 0, 0, 24),
            Position = UDim2.new(0.5, 0, 0, 0),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundColor3 = Color3.fromRGB(10, 10, 10),
            BorderSizePixel = 0,
            Parent = NotificationFrame,
            ZIndex = 1,
        })

        local NotificationStatus = Library:Create("ImageLabel", {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 3, 0.1, 0),
            BackgroundTransparency = 1,
            Image = Library.Notification.Images[config.Status] or Library.Notification.Images["Success"],
            ImageColor3 = (config.Status == "Success" and Color3.fromRGB(155, 255, 155)) or (config.Status == "Failed" and Color3.fromRGB(255, 155, 155)) or (config.Status == "Info" and Color3.fromRGB(155, 155, 155)) or Color3.fromRGB(255, 255, 255),
            Parent = MainNotificationInner,
        })

        local NotificationMessage = Library:Create("TextLabel", {
            Size = UDim2.new(0, 0, 0, 20),
            Position = UDim2.new(0, 28, 0.1, 0),
            BackgroundTransparency = 1,
            Text = config.Message,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = config.TextColor,
            TextWrapped = true,
            AutomaticSize = Enum.AutomaticSize.X,
            Font = Enum.Font.GothamBold,
            ZIndex = 2,
            Parent = MainNotificationInner,
        })

        local Shadow = Library:Create("UIShadow", {
            Spread = UDim2.new(0, 4, 0, 4),
            BlurRadius = UDim.new(0, 5),
            Offset = UDim2.new(0, 0, 0, 0),
            Color = Color3.fromRGB(0, 0, 0),
            Transparency = 0.5,
            Parent = MainNotificationInner,
        })

        Library:Create("UICorner", {
            CornerRadius = UDim.new(0, 5),
            Parent = MainNotificationInner,
        })

        Library:Create("UIPadding", {
            PaddingRight = UDim.new(0, 5),
            Parent = MainNotificationInner,
        })

        Library:Tween(MainNotificationInner, TweenInfo.new(Library.AnimationSpeed/1000, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, Library:GetTextSize(NotificationMessage.Text, NotificationMessage.Font, NotificationMessage.TextSize).X + 35, 0, 24),
        })

        task.spawn(function()
            task.wait(config.Time)
            Library:Tween(MainNotificationInner, TweenInfo.new(Library.AnimationSpeed/1000, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 0, 0, 24),
            })
            task.wait((Library.AnimationSpeed/1000)*0.65)
            MainNotificationInner:Destroy()
        end)
    end
end

return Library
